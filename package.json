{
  "name": "pi-somni",
  "version": "0.7.0-rc.3",
  "description": "Somni: layered memory with offline dreaming for the Pi coding agent. Every claim cites the transcript.",
  "keywords": ["pi-package", "pi", "memory", "agent-memory", "dreaming"],
  "license": "MIT",
  "type": "module",
  "repository": {"type": "git", "url": "git+https://github.com/Mechanacor3/pi-somni.git"},
  "files": [
    "bin/", "extensions/", "skills/", "somni/*.py", "somni/chel/*.py", "adapters/**/*.py",
    "evals/__init__.py", "evals/state_bench/__init__.py", "evals/state_bench/somni_state_bench.py",
    "README.md", "EVALUATION.md", "docs/everyday-use.md", "docs/settings.md", "docs/dreams.md",
    "docs/action-words.md", "docs/long-sessions.md", "docs/headless.md", "docs/sleep-and-memory.md", "docs/memory-over-time.md", "LICENSE"
  ],
  "bin": {"somni": "bin/somni"},
  "pi": {"extensions": ["./extensions/somni.ts"], "skills": ["./skills"]},
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
