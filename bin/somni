#!/usr/bin/env python3
"""somni: offline tools for a Somni memory setup.

    somni doctor [--cwd DIR] [--all] [--json]   check settings, runtime and the store
    somni config template                       print a commented config file with every setting
    somni config show [--cwd DIR]               print every setting's value and where it came from
    somni config table                          print the settings table in docs/settings.md
"""
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    command, rest = argv[0], argv[1:]
    if command == "doctor":
        from somni import doctor
        return doctor.main(rest)
    if command == "config":
        from somni import config
        if rest[:1] == ["show"]:
            return config.main(["resolve", *rest[1:]])
        return config.main(rest)
    print(f"somni: unknown command {command!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
