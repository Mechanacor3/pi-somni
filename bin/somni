#!/usr/bin/env python3
"""somni: offline tools for a Somni memory setup.

    somni doctor [--cwd DIR] [--all] [--json]   check settings, runtime and the store
    somni outcome --text TEXT [--verdict pass|fail|mixed] [--by WHO] [--run-label LABEL] [--image FILE] [--cwd DIR]
                                                record what happened afterwards, from outside the agent
    somni snapshot --out FILE [--personal | --store DIR] [--cwd DIR]
                                                save one memory store as a single file (safe while Pi records)
    somni restore FILE [--personal | --store DIR] [--cwd DIR] [--replace]
                                                restore a snapshot into a store, here or in another container
    somni snapshot --show FILE                  describe a snapshot without restoring it
    somni merge SOURCE [--personal | --store DIR] [--cwd DIR] [--forgetting wins|conflict|keep] [--dry-run]
                                                bring what a fork learned (a snapshot or a store) into this store
    somni config template                       print a commented config file with every setting
    somni config show [--cwd DIR]               print every setting's value and where it came from
    somni config table                          print the settings table in docs/settings.md
"""
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))


def outcome(argv):
    import argparse
    import os
    from somni import config as C
    from somni import store as S
    ap = argparse.ArgumentParser(prog="somni outcome", description="Record an outcome from outside the agent: a "
                                 "verdict, CI or test output, a review comment, what the user found afterwards.")
    ap.add_argument("--cwd", default=os.getcwd(), help="the directory Pi starts in (default: here)")
    S.outcome_arguments(ap)
    args = ap.parse_args(argv)
    values = {key: item["value"] for key, item in C.resolve(pathlib.Path(args.cwd).resolve(), dict(os.environ))["settings"].items()}
    workspace = pathlib.Path(values["store.path"])
    if not (workspace / S.STORE_DIR).is_dir():
        print(f"somni: no store at {workspace}; the first Pi session creates it", file=sys.stderr)
        return 2
    if args.image_bytes == S.DEFAULT_IMAGE_BYTES:
        args.image_bytes = values["recording.image_bytes"]
    try:
        print(S.record_outcome_from_args(S.SomniMemory(workspace, values["store.subject"]), args))
    except (S.MemoryError, OSError) as exc:
        print(f"somni: {exc}", file=sys.stderr)
        return 2
    return 0


def store_location(args):
    """The store a snapshot command means: --store, the personal store, or this directory's project store."""
    import os
    from somni import config as C
    values = {key: item["value"] for key, item in C.resolve(pathlib.Path(args.cwd).resolve(), dict(os.environ))["settings"].items()}
    if args.personal:
        path = values["personal.path"]
        if path in ("none", ""):
            raise SystemExit("somni: personal memory is off (personal.path is none)")
        return pathlib.Path("~/.somni" if path == "auto" else path).expanduser(), "personal"
    if args.store:
        return pathlib.Path(args.store).expanduser(), args.subject or values["store.subject"]
    return pathlib.Path(values["store.path"]), args.subject or values["store.subject"]


def snapshot_command(argv, restoring):
    import argparse
    import json
    import os
    from somni import snapshot as N
    from somni import store as S
    ap = argparse.ArgumentParser(prog="somni restore" if restoring else "somni snapshot",
                                 description="Restore a memory store from a snapshot." if restoring else
                                 "Save one memory store as a single file: its records, notes, dreams, wiki and words.")
    if restoring:
        ap.add_argument("file", help="the snapshot (.tar.gz) to restore")
        ap.add_argument("--replace", action="store_true", help="keep an existing store aside and restore over it")
    else:
        ap.add_argument("--out", help="the snapshot file to write (.tar.gz)")
        ap.add_argument("--show", metavar="FILE", help="describe a snapshot instead of making one")
    ap.add_argument("--cwd", default=os.getcwd(), help="the directory Pi starts in, which decides the store (default: here)")
    ap.add_argument("--personal", action="store_true", help="the personal store (~/.somni) instead of the project's")
    ap.add_argument("--store", help="the store directory (holding somni-v1/) instead of this directory's")
    ap.add_argument("--subject", help="the store's subject, when --store names a store with another subject")
    args = ap.parse_args(argv)
    try:
        if not restoring and args.show:
            print(json.dumps(N.describe(pathlib.Path(args.show)), indent=2))
            return 0
        workspace, subject = store_location(args)
        if restoring:
            result = N.restore(pathlib.Path(args.file), workspace, S.SomniMemory, replace=args.replace)
            print(json.dumps(result, indent=2))
            if result["subject"] != subject and not args.personal:
                print(f"somni: the restored store's subject is {result['subject']!r}; set store.subject to it "
                      f"(SOMNI_SUBJECT={result['subject']}) so Pi opens it", file=sys.stderr)
            return 0
        if not args.out:
            ap.error("--out is required")
        if not (workspace / S.STORE_DIR).is_dir():
            print(f"somni: no store at {workspace}", file=sys.stderr)
            return 2
        manifest = N.snapshot(S.SomniMemory(workspace, subject), pathlib.Path(args.out))
        print(json.dumps({"snapshot": args.out, "subject": manifest["subject"], "state": manifest["state"],
                          "files": len(manifest["files"])}, indent=2))
        return 0
    except (N.SnapshotError, S.MemoryError, OSError) as exc:
        print(f"somni: {exc}", file=sys.stderr)
        return 2


def merge_command(argv):
    import argparse
    import json
    import os
    from somni import config as C
    from somni import merge as M
    ap = argparse.ArgumentParser(prog="somni merge", description="Merge what another copy of this memory learned "
                                 "(a snapshot file or a store directory) into this store, like a git merge of forks.")
    ap.add_argument("source", help="the other side: a snapshot (.tar.gz) or a directory holding somni-v1/")
    ap.add_argument("--cwd", default=os.getcwd(), help="the directory Pi starts in, which decides the store (default: here)")
    ap.add_argument("--personal", action="store_true", help="merge into the personal store (~/.somni)")
    ap.add_argument("--store", help="the store directory (holding somni-v1/) to merge into")
    ap.add_argument("--subject", help="the store's subject, when --store names a store with another subject")
    ap.add_argument("--forgetting", choices=M.FORGETTING,
                    help="a shared record one side forgot: wins (forget it here too), conflict (stop and list them), "
                         "keep (take the whole text back). Default: the merge.forgetting setting")
    ap.add_argument("--dry-run", action="store_true", help="report what the merge would do; write nothing")
    ap.add_argument("--unrelated", action="store_true", help="merge a store that shares no history with this one")
    ap.add_argument("--label", help="what the merge pass calls the other side (default: the source's name)")
    args = ap.parse_args(argv)
    try:
        forgetting = args.forgetting or C.resolve(pathlib.Path(args.cwd).resolve(), dict(os.environ))[
            "settings"]["merge.forgetting"]["value"]
        workspace, subject = store_location(args)
        report = M.merge(workspace, subject, pathlib.Path(args.source), forgetting=forgetting,
                         unrelated=args.unrelated, dry_run=args.dry_run, label=args.label)
        print(json.dumps(report, indent=2))
        return 0
    except (M.MergeError, OSError) as exc:
        print(f"somni: {exc}", file=sys.stderr)
        return 2
    except C.ConfigError as exc:
        print(f"somni: {exc}", file=sys.stderr)
        return 2


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    command, rest = argv[0], argv[1:]
    if command == "doctor":
        from somni import doctor
        return doctor.main(rest)
    if command == "outcome":
        return outcome(rest)
    if command in ("snapshot", "restore"):
        return snapshot_command(rest, command == "restore")
    if command == "merge":
        return merge_command(rest)
    if command == "config":
        from somni import config
        if rest[:1] == ["show"]:
            return config.main(["resolve", *rest[1:]])
        return config.main(rest)
    print(f"somni: unknown command {command!r}\n\n{__doc__.strip()}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
